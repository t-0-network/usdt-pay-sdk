{
  "name": "@t-0/usdt-pay-sdk",
  "version": "0.2.0",
  "description": "SDK for the t-0 QR payment flow (tzero.v1.pay)",
  "repository": {
    "type": "git",
    "url": "git@github.com:t-0-network/usdt-pay-sdk.git"
  },
  "author": "New Settlement Technologies Inc.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib/**/*"
  ],
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/index.d.ts",
        "default": "./lib/esm/index.js"
      },
      "require": {
        "types": "./lib/cjs/index.d.ts",
        "default": "./lib/cjs/index.js"
      }
    },
    "./crypto": {
      "import": {
        "types": "./lib/esm/crypto.d.ts",
        "default": "./lib/esm/crypto.js"
      },
      "require": {
        "types": "./lib/cjs/crypto.d.ts",
        "default": "./lib/cjs/crypto.js"
      }
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "@connectrpc/connect": "^2.1.1",
    "@noble/curves": "^2.2.0",
    "@t-0/provider-sdk": "1.1.38"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "buf:generate": "buf generate",
    "build": "npm run build:esm && npm run build:cjs && npm run build:post",
    "prepare": "npm run build",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:post": "node -e \"require('fs').writeFileSync('lib/cjs/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts"
  }
}
