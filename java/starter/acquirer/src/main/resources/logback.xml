<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Pushes the levels below down into java.util.logging, so the JUL loggers grpc
         uses stop building records logback would only drop. The bridge Main installs
         is what routes those records here in the first place. -->
    <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>DENY</onMatch>
            <onMismatch>NEUTRAL</onMismatch>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Set root log level -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="STDERR"/>
    </root>

    <!-- This starter and the t-0 SDKs. -->
    <logger name="network.t0" level="INFO"/>

    <!-- gRPC logging (set to WARN to reduce noise) -->
    <logger name="io.grpc" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
</configuration>
