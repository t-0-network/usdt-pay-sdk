# Acquirer configuration.
#
# The scaffolder writes your generated PRIVATE_KEY into .env. Edit that file in
# place and never overwrite it with this one: the matching public key is already
# with the t-0 team, and the private half is not recoverable.

# Your acquirer's secp256k1 private key (hex). Every request you send to t-0 is
# signed with it; the matching public key is what t-0 knows you by.
PRIVATE_KEY=

# t-0's public key. Callbacks are rejected unless they verify against it.
NETWORK_PUBLIC_KEY=

# t-0 API endpoint.
TZERO_ENDPOINT=https://usdt-pay-api-sandbox.t-0.network

# Port your callback server listens on. t-0 must be able to reach it.
PORT=8080
