# Acquirer configuration.
#
# The scaffolder writes your generated PROVIDER_PRIVATE_KEY into .env. Edit that file in
# place and never overwrite it with this one: the matching public key is already
# with the t-0 team, and the private half is not recoverable.

# Your acquirer's secp256k1 private key (hex). Every request you send to t-0 is
# signed with it; the matching public key is what t-0 knows you by.
PROVIDER_PRIVATE_KEY=

# t-0's public key: uncompressed secp256k1 — 0x04 followed by 128 more hex digits,
# 130 in total. Callbacks are rejected unless they verify against it.
# The value below is the sandbox key; production comes from your t-0 onboarding contact.
NETWORK_PUBLIC_KEY=0x04dd549e27ef8acc1c9d2027d7973b1e5d8e014ce5ac36424ef9f7a3ee8a44029dee77d7acbc8e8980453eadc4e60db153403febd147e14c8444de806943524d3e

# t-0 API endpoint.
TZERO_ENDPOINT=https://usdt-pay-api-sandbox.t-0.network

# Port your callback server listens on. t-0 must be able to reach it.
PORT=8080
